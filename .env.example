# Werte aus der .env des ALTEN Stacks übernehmen (/opt/stacks/ts6-backend/.env),
# sonst gehen beim Datenumzug die gespeicherten Bot-Identitäten/Passwörter kaputt.
# Komplett neu ohne alte Daten? Dann neue Werte erzeugen: openssl rand -hex 32
JWT_SECRET=HIER_EINTRAGEN
ENCRYPTION_KEY=
FRONTEND_URL=http://DEINE-SERVER-IP:3000
TS_ALLOW_SELF_SIGNED=false
